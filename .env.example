# Contraseña local. En producción pon una propia.
APP_PASSWORD=
# Firma de la sesión. Si la omites, se usa APP_PASSWORD.
AUTH_SECRET=
# Postgres de Supabase. Sin esto, la app guarda en .data/store.json (solo sirve en local).
DATABASE_URL=
# Correo diario. Sin clave, la bandeja sigue funcionando.
RESEND_API_KEY=
NOTIFY_EMAIL=
# Protege /api/cron/fetch. Vercel Cron envía Authorization: Bearer <CRON_SECRET>.
CRON_SECRET=
